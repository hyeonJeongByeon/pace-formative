# Environment variables for the serverless proxy (DESIGN_SPEC.md §1, §7).
# Copy to .env for local development. NEVER commit .env — it is gitignored.
# In production, set these in the proxy host's dashboard (Cloudflare Workers
# secrets / Vercel environment variables), not in any file in this repo.

# Anthropic API key. Frontend never sees this; only the proxy uses it.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Study passcode participants enter once; the proxy rejects requests without it
# (DESIGN_SPEC.md §1: proxy enforces a passcode + basic rate limiting).
STUDY_PASSCODE=choose-a-passcode
